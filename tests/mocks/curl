#!/usr/bin/env bash

output=""
url=""

while (( $# > 0 )); do
	case "$1" in
		--output)
			output=$2
			shift 2
			;;
		--)
			url=$2
			shift 2
			;;
		*)
			shift
			;;
	esac
done

[[ -n "$output" && "$url" =~ ^https?:// ]] || exit 2
printf 'mock image\n' > "$output"
if [[ -n "${GASHELL_TEST_CURL_LOG:-}" ]]; then
	printf '%s\n' "$output" > "$GASHELL_TEST_CURL_LOG"
fi
